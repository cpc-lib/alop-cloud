{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InvoiceIssued",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "tenantId",
    "traceId",
    "occurredAt",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "eventType": {
      "const": "invoice.invoice.issued.v1"
    },
    "eventVersion": {
      "const": "1.0"
    },
    "aggregateType": {
      "type": "string"
    },
    "aggregateId": {
      "type": "string"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 0
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "traceId": {
      "type": "string"
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "required": [
        "invoiceId",
        "applicationId",
        "invoiceNo",
        "amount",
        "provider",
        "allocationIds"
      ],
      "properties": {
        "invoiceId": {
          "type": "integer"
        },
        "applicationId": {
          "type": "integer"
        },
        "invoiceNo": {
          "type": "string"
        },
        "amount": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "allocationIds": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}