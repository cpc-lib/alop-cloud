{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"PaymentClosed",
  "type":"object",
  "required":["eventId","eventType","eventVersion","aggregateType","aggregateId","aggregateVersion","tenantId","traceId","occurredAt","data"],
  "properties":{
    "eventId":{"type":"string"},
    "eventType":{"const":"payment.payment.closed.v1"},
    "eventVersion":{"const":"1.0"},
    "aggregateType":{"const":"PaymentOrder"},
    "aggregateId":{"type":"string"},
    "aggregateVersion":{"type":"integer"},
    "tenantId":{"type":"string"},
    "traceId":{"type":"string"},
    "correlationId":{"type":["string","null"]},
    "occurredAt":{"type":"string","format":"date-time"},
    "data":{
      "type":"object",
      "required":["paymentOrderId","paymentNo","closedAt","reasonCode"],
      "properties":{
        "paymentOrderId":{"type":"integer"},
        "paymentNo":{"type":"string"},
        "closedAt":{"type":"string","format":"date-time"},
        "reasonCode":{"type":"string"}
      },
      "additionalProperties":false
    }
  },
  "additionalProperties":false
}
