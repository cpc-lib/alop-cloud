{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agreement.resource-transfer.requested.v1",
  "title": "ResourceTransferRequested",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "tenantId",
    "traceId",
    "occurredAt",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "eventType": {
      "const": "agreement.resource-transfer.requested.v1"
    },
    "eventVersion": {
      "const": "1.0"
    },
    "aggregateType": {
      "const": "ResourceTransfer"
    },
    "aggregateId": {
      "type": "string"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 0
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "traceId": {
      "type": "string"
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "required": [
        "transferId",
        "transferNo",
        "agreementId",
        "fromResourceUnitId",
        "toResourceUnitId",
        "requestedEffectiveAt"
      ],
      "properties": {
        "transferId": {
          "type": "integer"
        },
        "transferNo": {
          "type": "string"
        },
        "agreementId": {
          "type": "integer"
        },
        "fromResourceUnitId": {
          "type": "integer"
        },
        "toResourceUnitId": {
          "type": "integer"
        },
        "requestedEffectiveAt": {
          "type": "string",
          "format": "date-time"
        },
        "reasonType": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
