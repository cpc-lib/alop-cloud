{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "billing.utility-charge.billed.v1",
  "title": "UtilityChargeBilled",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "tenantId",
    "traceId",
    "occurredAt",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "eventType": {
      "const": "billing.utility-charge.billed.v1"
    },
    "eventVersion": {
      "const": "1.0"
    },
    "aggregateType": {
      "const": "Bill"
    },
    "aggregateId": {
      "type": "string"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 0
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "traceId": {
      "type": "string"
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "required": [
        "billId",
        "billNo",
        "chargeType",
        "usage",
        "amount",
        "currency"
      ],
      "properties": {
        "billId": {
          "type": "integer"
        },
        "billNo": {
          "type": "string"
        },
        "chargeType": {
          "type": "string",
          "enum": [
            "WATER",
            "ELECTRICITY",
            "EV_CHARGING_ELECTRICITY",
            "UTILITY_ADJUSTMENT"
          ]
        },
        "usage": {
          "type": "string"
        },
        "amount": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d{1,2})?$"
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        "meterId": {
          "type": "integer"
        },
        "readingId": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
