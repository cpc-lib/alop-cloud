{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"PaymentRefunded",
  "type":"object",
  "required":["eventId","eventType","eventVersion","aggregateType","aggregateId","aggregateVersion","tenantId","traceId","occurredAt","data"],
  "properties":{
    "eventId":{"type":"string"},
    "eventType":{"const":"payment.refund.succeeded.v1"},
    "eventVersion":{"const":"1.0"},
    "aggregateType":{"const":"RefundOrder"},
    "aggregateId":{"type":"string"},
    "aggregateVersion":{"type":"integer"},
    "tenantId":{"type":"string"},
    "traceId":{"type":"string"},
    "correlationId":{"type":["string","null"]},
    "occurredAt":{"type":"string","format":"date-time"},
    "data":{
      "type":"object",
      "required":["refundId","refundNo","paymentOrderId","paymentNo","originalTransactionId","refundTransactionId","refundReservationId","channel","providerRefundNo","refundAmount","currency","succeededAt"],
      "properties":{
        "refundId":{"type":"integer"},
        "refundNo":{"type":"string"},
        "paymentOrderId":{"type":"integer"},
        "paymentNo":{"type":"string"},
        "originalTransactionId":{"type":"integer"},
        "refundTransactionId":{"type":"integer"},
        "refundReservationId":{"type":"string"},
        "channel":{"type":"string"},
        "providerRefundNo":{"type":"string"},
        "refundAmount":{"type":"string"},
        "currency":{"type":"string"},
        "succeededAt":{"type":"string","format":"date-time"}
      },
      "additionalProperties":false
    }
  },
  "additionalProperties":false
}
