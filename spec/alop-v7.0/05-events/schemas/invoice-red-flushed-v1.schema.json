{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "invoice.invoice.red-flushed.v1",
  "title": "InvoiceRedFlushed",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "tenantId",
    "traceId",
    "occurredAt",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "eventType": {
      "const": "invoice.invoice.red-flushed.v1"
    },
    "eventVersion": {
      "const": "1.0"
    },
    "aggregateType": {
      "const": "Invoice"
    },
    "aggregateId": {
      "type": "string"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 0
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "traceId": {
      "type": "string"
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "required": [
        "invoiceId",
        "invoiceNo",
        "redInvoiceId",
        "redInvoiceNo",
        "amount",
        "currency"
      ],
      "properties": {
        "invoiceId": {
          "type": "integer"
        },
        "invoiceNo": {
          "type": "string"
        },
        "redInvoiceId": {
          "type": "integer"
        },
        "redInvoiceNo": {
          "type": "string"
        },
        "amount": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d{1,2})?$"
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        "redFlushedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
