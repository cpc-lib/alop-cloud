{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BillIssued",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "tenantId",
    "traceId",
    "occurredAt",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "eventType": {
      "const": "billing.bill.issued.v1"
    },
    "eventVersion": {
      "const": "1.0"
    },
    "aggregateType": {
      "type": "string"
    },
    "aggregateId": {
      "type": "string"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 0
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "traceId": {
      "type": "string"
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "required": [
        "billId",
        "billNo",
        "agreementId",
        "customerId",
        "chargeType",
        "dueDate",
        "payableAmount",
        "currency"
      ],
      "properties": {
        "billId": {
          "type": "integer"
        },
        "billNo": {
          "type": "string"
        },
        "agreementId": {
          "type": "integer"
        },
        "customerId": {
          "type": "integer"
        },
        "chargeType": {
          "type": "string"
        },
        "dueDate": {
          "type": "string",
          "format": "date"
        },
        "payableAmount": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}