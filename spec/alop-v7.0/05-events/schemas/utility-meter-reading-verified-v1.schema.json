{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Utility Meter Reading Verified",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "aggregateId",
    "tenantId",
    "occurredAt",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string"
    },
    "eventType": {
      "const": "asset.utility-meter.reading-verified.v1"
    },
    "eventVersion": {
      "const": "1.0"
    },
    "aggregateType": {
      "type": "string"
    },
    "aggregateId": {
      "type": "string"
    },
    "aggregateVersion": {
      "type": "integer"
    },
    "tenantId": {
      "type": "string"
    },
    "traceId": {
      "type": "string"
    },
    "correlationId": {
      "type": "string"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "properties": {
        "meterId": {
          "type": "integer"
        },
        "readingId": {
          "type": "integer"
        },
        "utilityType": {
          "enum": [
            "WATER",
            "ELECTRICITY"
          ]
        },
        "unitCode": {
          "enum": [
            "M3",
            "KWH"
          ]
        },
        "periodStart": {
          "type": "string",
          "format": "date-time"
        },
        "periodEnd": {
          "type": "string",
          "format": "date-time"
        },
        "consumption": {
          "type": "string"
        },
        "resourceUnitIds": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "handoverOrderId": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "meterId",
        "readingId",
        "utilityType",
        "unitCode",
        "periodStart",
        "periodEnd",
        "consumption"
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
