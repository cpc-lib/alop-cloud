{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"RefundFailed",
  "type":"object",
  "required":["eventId","eventType","eventVersion","aggregateType","aggregateId","aggregateVersion","tenantId","traceId","occurredAt","data"],
  "properties":{
    "eventId":{"type":"string"},
    "eventType":{"const":"payment.refund.failed.v1"},
    "eventVersion":{"const":"1.0"},
    "aggregateType":{"const":"RefundOrder"},
    "aggregateId":{"type":"string"},
    "aggregateVersion":{"type":"integer"},
    "tenantId":{"type":"string"},
    "traceId":{"type":"string"},
    "correlationId":{"type":["string","null"]},
    "occurredAt":{"type":"string","format":"date-time"},
    "data":{
      "type":"object",
      "required":["refundId","refundNo","paymentNo","refundReservationId","reasonCode","reservationAction"],
      "properties":{
        "refundId":{"type":"integer"},
        "refundNo":{"type":"string"},
        "paymentNo":{"type":"string"},
        "refundReservationId":{"type":"string"},
        "reasonCode":{"type":"string"},
        "reservationAction":{"const":"RELEASE"}
      },
      "additionalProperties":false
    }
  },
  "additionalProperties":false
}
